---
import { u } from '../../lib';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { getNews, ym } from '../../lib';

const news = await getNews();
---
<Layout title="最新消息" active={-1}>
  <Hero eyebrow="News" title="最新消息" lead="論文發表、獲獎與實驗室動態。" />
  <section class="wrap" style="padding-top:48px;padding-bottom:88px">
    <div class="news-list">
      {news.map((n) => (
        <a class="news-item" href={u(`/news/${n.id}/`)}>
          {n.data.cover && <img src={u(n.data.cover)} alt="" loading="lazy" />}
          <span class="news-date">{ym(n.data.date)}</span>
          <b>{n.data.title}</b>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .news-list { display: flex; flex-direction: column; }
  .news-item { display: grid; grid-template-columns: 84px 1fr; align-items: baseline; gap: 4px 28px; padding: 20px 0; border-top: 1px solid var(--line); text-decoration: none; color: var(--ink); font-size: 17px; line-height: 1.6; }
  .news-item:last-child { border-bottom: 1px solid var(--line); }
  .news-item:hover { color: var(--accent-ink); }
  .news-item img { grid-column: 1 / -1; width: 100%; max-height: 240px; object-fit: cover; border-radius: 4px; }
  .news-date { font-family: var(--latin); font-size: 14px; color: var(--muted); }
  @media (max-width: 767px) { .news-item { grid-template-columns: 1fr; } }
</style>
