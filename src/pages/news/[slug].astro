---
import { u } from '../../lib';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { render } from 'astro:content';
import { getNews, ym } from '../../lib';

export async function getStaticPaths() {
  return (await getNews()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Layout title={entry.data.title} active={-1}>
  <Hero eyebrow={`News · ${ym(entry.data.date)}`} title={entry.data.title} />
  <article class="wrap" style="padding-top:48px;padding-bottom:88px;display:flex;flex-direction:column;gap:24px;max-width:820px">
    {entry.data.cover && <img src={u(entry.data.cover)} alt="" style="width:100%;border-radius:6px" />}
    <div class="prose"><Content /></div>
    <a href={u('/news/')} style="font-size:15px">← 全部消息</a>
  </article>
</Layout>
