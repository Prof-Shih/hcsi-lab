---
import { u } from '../lib';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import galleryData from '../data/gallery.json';
import { NAV } from '../config/nav';
import { getMembers, undergradProjects, initial } from '../lib';

const { pi, current, alumni } = await getMembers();
// 選了拉拉看風格的人，頭像改用拉拉看照片並啟用互動
// 燈箱在瀏覽器端換圖，路徑先加好 base
const gallery = galleryData.map((g) => ({ ...g, img: u(g.img) }));
// 年級依入學年與建置當下的學年推算（8 月起算新學年），例：2025 入學的碩士生在 2026 學年是碩二
const now = new Date();
const ay = now.getMonth() >= 7 ? now.getFullYear() : now.getFullYear() - 1;
const gradeOf = (role: string, y?: number) => {
  const n = y ? ay - y + 1 : 0;
  if (n < 1 || n > 9) return role;
  return role === '碩士生' ? `碩${'一二三四五六七八九'[n - 1]}` : role === '博士生' ? `博${'一二三四五六七八九'[n - 1]}` : role;
};
const people = [...pi, ...current].map(({ data }) => ({ ...data, ...(data.role === '教授' ? { photo: '/images/pi-suit.jpg' } : {}), role: gradeOf(data.role, data.enroll_year), lala: data.avatar_style === '拉拉看' ? data.lala_photo : undefined }));
// 依年級分區：高年級在前，推算不出年級的（沒填入學年）放最後
const rank = (r: string) => '博碩'.indexOf(r[0]) * 10 - '一二三四五六七八九'.indexOf(r[1]);
const key = (r: string) => (r === '教授' ? -99 : /^[博碩][一二三四五六七八九]$/.test(r) ? rank(r) : 99);
const groups = [...new Set(people.map((m) => m.role))]
  .sort((a, b) => key(a) - key(b))
  .map((role) => {
    const list = people.filter((m) => m.role === role);
    const y = list.find((m) => m.enroll_year)?.enroll_year;
    const n = '一二三四五六七八九'.indexOf(role[1]) + 1;
    return { role: role === '教授' ? '指導教授' : role, pi: role === '教授', list, code: role === '教授' ? 'PI' : n > 0 ? `${role[0] === '博' ? 'D' : 'M'}${n}` : '', sub: role === '教授' ? 'Principal Investigator' : y && n > 0 ? `${y} 入學` : '年級請到「我的資料」填入學年' };
  });
// 教授卡的身分象徵只取 pi.json 裡有記載的頭銜與獎項，不自行加
const crest = [
  { k: 'IEEE', v: 'Senior Member' },
  { k: '副編輯', v: 'IEEE Trans. on Consumer Electronics' },
  { k: '副編輯', v: 'IEEE Trans. on CSVT（2022–2025）' },
  { k: 'Program Co-Chair', v: 'ICCE-TW 2026' },
  { k: '2019', v: '科技部 未來科技獎' },
  { k: '2014', v: 'ACM 李國鼎青年研究獎' },
];

// 介紹卡顯示的網址：去掉 https:// 與結尾斜線
const siteLabel = (s: string) => {
  try { const x = new URL(s); return (x.host + x.pathname).replace(/\/$/, ''); } catch { return s; }
};
const pal = [['#DCE5E0', '#3D5A50'], ['#F3E8DC', '#7A5634'], ['#F6DCD3', '#8A3E2A'], ['#DDE6EE', '#2F4A63'], ['#EAE3F0', '#5A4570'], ['#E6EBD8', '#4C5A2E']];
const seen = new Set<string>();
const ugs: { name: string; topic: string }[] = [];
undergradProjects.forEach((p) => p.names.forEach((n) => { if (!seen.has(n)) { seen.add(n); ugs.push({ name: n, topic: p.zh }); } }));
---
<Layout title="成員" active={NAV.members}>
  <Hero eyebrow="Members & Lab Life" title="我們是誰" lead="滑鼠移到頭像上看每個人的介紹；往下看實驗室的日常照片與影片。">
    <div style="display:flex;flex-wrap:wrap;gap:10px;padding-top:6px">
      <a class="btn btn-coral" href="#people" style="min-height:44px;padding:0 20px">成員</a>
      <a class="btn btn-ghost-light" href="#life" style="min-height:44px;padding:0 20px">實驗室日常</a>
    </div>
  </Hero>

  <section id="people" class="wrap" style="padding-top:56px;padding-bottom:72px;display:flex;flex-direction:column;gap:24px">
    <div class="sec-head"><h2>目前成員</h2><span>{people.length} 位 · 中央大學</span></div>
    {groups.map((g) => (
    <div class:list={['grade reveal', { 'grade-pi': g.pi }]}>
      <div class="grade-head">
        {g.code && <span class="grade-code" aria-hidden="true">{g.code}</span>}
        <span class="stack" style="gap:2px"><b>{g.role}</b><span>{g.sub} · {g.list.length} 位</span></span>
      </div>
    <div class="people">
      {g.list.map((m) => people.indexOf(m)).map((i) => [people[i], i] as const).map(([m, i]) => (
        <div class:list={['person has-pop', `tier-${g.code || 'x'}`]}>
          <div class="frame" data-tilt={m.lala ? undefined : ''}>
          {g.pi && (
            <svg class="laurel" viewBox="0 0 220 220" aria-hidden="true">
              {Array.from({ length: 8 }, (_, k) => [-1, 1].map((sd) => (
                <ellipse rx="12" ry="5" transform={`translate(${110 + sd * 100 * Math.cos(0.5 + k * 0.29)} ${110 + 100 * Math.sin(0.5 + k * 0.29)}) rotate(${sd * (70 - k * 17)})`} />
              )))}
            </svg>
          )}
          <span class="ring" aria-hidden="true"></span>
          {g.pi && <span class="orbit" aria-hidden="true"><i></i></span>}
          <button type="button" class:list={['face', { lala: m.lala }]} data-lala={u(m.lala)} aria-label={m.lala ? `${m.name} 介紹（拉拉看：可以拉長頭像）` : `${m.name} 介紹`} style={`background:${pal[i % 6][0]};color:${pal[i % 6][1]}`} data-zoom={u(m.lala ?? m.photo)} data-name={m.name}>
            {m.lala || m.photo ? <img src={u(m.lala ?? m.photo)} alt="" /> : initial(m.name)}
            <span class="shine" aria-hidden="true"></span>
          </button>
          {g.pi && <span class="seal" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24"><path d="M3 18h18l-1.6-10-4.9 4.2L12 5l-2.5 7.2L4.6 8z" fill="currentColor" /></svg></span>}
          </div>
          <b style="font-size:18px">{m.name}</b>
          <span class="note">{g.pi ? '指導教授 · 副教授' : m.role}</span>
          <div class="pop card" role="dialog" aria-label={m.name} style={`top:150px;width:min(300px,86vw);gap:14px;--tint:${pal[i % 6][0]};--tint-ink:${pal[i % 6][1]}`}>
            <div class="card-head">
              {m.card_photo || m.photo || m.lala ? <img class="mini" src={u(m.card_photo ?? m.photo ?? m.lala)} data-zoom={u(m.card_photo ?? m.photo ?? m.lala)} data-name={m.name} alt="" loading="lazy" title="點兩下放大" /> : <span class="mini">{initial(m.name)}</span>}
              <span class="stack" style="gap:3px;min-width:0"><b style="font-size:18px;line-height:1.2">{m.name}</b>{m.name_en && <span class="en">{m.name_en}</span>}<span class="badge">{g.pi ? '指導教授' : m.role}</span></span>
            </div>
            {g.pi && (
              <div class="stack" style="gap:6px;font-size:13.5px;line-height:1.5">
                <span style="font-size:12px;color:var(--muted)">國立中央大學 資訊管理學系 副教授</span>
                <ul class="crest">{crest.map((c) => <li><b>{c.k}</b><span>{c.v}</span></li>)}</ul>
                <a class="crest-more" href={u('/pi/')}>完整學經歷與獎項 →</a>
              </div>
            )}
            {!g.pi && (m.edu || m.topic || m.interests.length > 0) && (
              <div class="stack" style="gap:4px;font-size:14px;line-height:1.6"><span style="font-size:12px;color:var(--muted)">學經歷</span>{m.edu && <span>{m.edu}</span>}{m.topic && <span>{m.topic}</span>}{m.interests.length > 0 && <span>{m.interests.join('、')}</span>}</div>
            )}
            {m.website && (
              <a class="site" href={m.website} target="_blank" rel="noopener">
                <span class="site-ico" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg></span>
                <span class="stack" style="gap:1px;min-width:0"><b style="font-size:14px">個人網站</b><span class="site-url">{siteLabel(m.website)}</span></span>
                <span class="site-go" aria-hidden="true">↗</span>
              </a>
            )}
            <div class="links">
              {m.instagram && <a href={u(`https://instagram.com/${m.instagram}`)} target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>@{m.instagram}</a>}
              {m.email ? <a href={`mailto:${m.email}`}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>{m.email}</a> : <span class="note">信箱 [待補]</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
    </div>
    ))}
    <span class="note">成員資料由後台「成員」維護（照片、身分、信箱、學經歷）。</span>
  </section>

  <section id="life" style="background:var(--night);color:#F2EFE8">
    <div class="wrap reveal" style="padding-top:72px;padding-bottom:72px;display:flex;flex-direction:column;gap:24px">
      <div class="row-between">
        <div class="stack" style="gap:8px">
          <div class="eyebrow" style="color:#A9C4B8">Lab Life</div>
          <h2 style="margin:0;font-family:var(--serif);font-size:36px;font-weight:700">實驗室日常</h2>
        </div>
        <div class="life-filters" role="group" aria-label="篩選">
          <button type="button" data-k="all" aria-pressed="true">全部</button>
          <button type="button" data-k="photo" aria-pressed="false">照片</button>
          <button type="button" data-k="video" aria-pressed="false">影片</button>
        </div>
      </div>
      <div class="mosaic">
        {gallery.map((g, i) => (
          <button type="button" class="tile zoom" data-i={i} data-kind={g.kind} aria-label={g.cap} style={`background:${g.bg};grid-column:span ${g.col};grid-row:span ${g.row}`}>
            {g.img ? <img src={u(g.img)} alt="" loading="lazy" /> : <span class="tile-ph">[{g.kind === 'video' ? '影片' : '照片'}待補]</span>}
            {g.kind === 'video' && <span class="play" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="#1F2622"><path d="M8 5v14l11-7z"></path></svg></span>}
            <span class="tile-cap">{g.cap}</span>
          </button>
        ))}
      </div>
      <span style="font-size:13px;color:#B9C4BF">大家的照片、影片放進 src/data/gallery.json 就會出現在這裡。</span>
    </div>
  </section>

  <dialog class="avatar-view" aria-label="頭像">
    <img alt="" />
    <div class="av-bar">
      <b class="av-name"></b>
      <span style="display:flex;gap:8px">
        <a class="av-dl" download><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m-5-5 5 5 5-5M5 20h14" /></svg>下載</a>
        <button type="button" class="av-close">關閉</button>
      </span>
    </div>
  </dialog>

  <dialog class="lightbox" aria-label="照片檢視">
    <div class="lb-frame"><img alt="" /><span class="lb-ph"></span></div>
    <div class="lb-bar">
      <span class="lb-cap"></span>
      <span style="display:flex;gap:8px">
        <button type="button" class="lb-prev" aria-label="上一張">‹</button>
        <button type="button" class="lb-next" aria-label="下一張">›</button>
        <button type="button" class="lb-close">關閉</button>
      </span>
    </div>
  </dialog>

  <section class="reveal" style="background:var(--surface);border-top:1px solid var(--line)">
    <div class="wrap" style="padding-top:64px;padding-bottom:88px;display:flex;flex-direction:column;gap:24px">
      <div class="sec-head"><h2>畢業碩士</h2><span>{alumni.length} 位</span></div>
      <div class="alumni">
        {alumni.map(({ data: m }) => (
          <div class="alum has-pop" tabindex="0">
            <span class="alum-face">{initial(m.name)}</span>
            <b style="font-size:15px">{m.name}</b>
            <span style="font-family:var(--latin);font-size:12px;color:var(--muted)">{m.grad_year}</span>
            <div class="pop" role="tooltip" style="top:104px;width:min(260px,80vw);padding:16px;gap:6px">
              <span style="font-size:12px;color:var(--muted)">碩士論文 · {m.grad_year}</span>
              <b style="font-size:14px;line-height:1.55">{m.thesis}</b>
              {m.honor && <span class="star">★ {m.honor}</span>}
            </div>
          </div>
        ))}
      </div>
      <div class="sec-head" style="padding-top:32px"><h2>歷屆專題生</h2><span>{ugs.length} 位</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:8px">
        {ugs.map((s) => <a href={u('/undergrad/')} title={s.topic} class="ug">{s.name}</a>)}
      </div>
    </div>
  </section>
</Layout>

<script>
  // 拉拉看頭像（只有選了拉拉看風格的成員才有 data-lala）
  import { mountLala } from '../scripts/lala';
  mountLala();
</script>

<script define:vars={{ gallery }}>
  // 頭像：手機沒有 hover，點一下打開介紹，點別處關閉
  document.querySelectorAll('.person .face').forEach((b) => b.addEventListener('click', (e) => {
    e.stopPropagation();
    const p = b.closest('.person');
    const was = p.classList.contains('open');
    document.querySelectorAll('.person.open').forEach((x) => x.classList.remove('open'));
    if (!was) { p.classList.add('open'); keepIn(p); }
  }));
  document.addEventListener('click', () => document.querySelectorAll('.person.open').forEach((x) => x.classList.remove('open')));

  // 介紹卡片置中在頭像下方，靠螢幕邊的頭像會讓卡片超出畫面：打開時往內推回來
  function keepIn(h) {
    const p = h.querySelector(':scope > .pop');
    if (!p) return;
    p.style.translate = '';
    const r = p.getBoundingClientRect();
    if (!r.width) return;
    const m = 12, vw = document.documentElement.clientWidth;
    const dx = r.left < m ? m - r.left : r.right > vw - m ? vw - m - r.right : 0;
    if (dx) p.style.translate = `calc(-50% + ${dx}px) 0`;
  }
  document.querySelectorAll('.has-pop').forEach((h) => {
    h.addEventListener('mouseenter', () => keepIn(h));
    h.addEventListener('focusin', () => keepIn(h));
  });

  // 頭像 3D 傾斜（只有滑鼠；拉拉看頭像要拖曳，不加）
  if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.frame[data-tilt]').forEach((f) => {
      f.addEventListener('pointermove', (e) => {
        const r = f.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        f.classList.add('tilting');
        f.style.setProperty('--ry', `${(x - 0.5) * 24}deg`);
        f.style.setProperty('--rx', `${(0.5 - y) * 24}deg`);
        f.style.setProperty('--mx', `${x * 100}%`);
        f.style.setProperty('--my', `${y * 100}%`);
      });
      f.addEventListener('pointerleave', () => {
        f.classList.remove('tilting');
        ['--rx', '--ry', '--mx', '--my'].forEach((k) => f.style.removeProperty(k));
      });
    });
  }

  // 頭貼（大頭貼與介紹卡小頭像）點兩下放大，可下載。
  // 自己算兩次點擊的間隔，手機點兩下也有效（手機瀏覽器不一定會送 dblclick）
  const av = document.querySelector('.avatar-view');
  const avImg = av.querySelector('img');
  const avDl = av.querySelector('.av-dl');
  const openAvatar = (src, name) => {
    document.querySelectorAll('.person.open').forEach((x) => x.classList.remove('open'));
    avImg.src = src; avImg.alt = `${name} 的頭像`;
    av.querySelector('.av-name').textContent = name;
    avDl.href = src;
    avDl.download = `${name}${(src.match(/\.\w+$/) || ['.jpg'])[0]}`;
    av.showModal();
  };
  document.querySelectorAll('[data-zoom]').forEach((el) => {
    let last = 0;
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      const now = Date.now();
      if (now - last < 350) { last = 0; openAvatar(el.dataset.zoom, el.dataset.name); }
      else last = now;
    });
  });
  av.querySelector('.av-close').addEventListener('click', () => av.close());
  av.addEventListener('click', (e) => { e.stopPropagation(); if (e.target === av) av.close(); });

  // 實驗室日常篩選
  const fbtns = [...document.querySelectorAll('.life-filters button')];
  const tiles = [...document.querySelectorAll('.tile')];
  fbtns.forEach((b) => b.addEventListener('click', () => {
    fbtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    tiles.forEach((t) => { t.hidden = !(b.dataset.k === 'all' || t.dataset.kind === b.dataset.k); });
  }));

  // 燈箱
  const lb = document.querySelector('.lightbox');
  const img = lb.querySelector('img');
  const ph = lb.querySelector('.lb-ph');
  const frame = lb.querySelector('.lb-frame');
  const cap = lb.querySelector('.lb-cap');
  let cur = 0;
  const show = (i) => {
    cur = (i + gallery.length) % gallery.length;
    const g = gallery[cur];
    frame.style.background = g.bg;
    img.hidden = !g.img; if (g.img) { img.src = g.img; img.alt = g.cap; }
    ph.textContent = g.img ? '' : `[${g.kind === 'video' ? '影片' : '照片'}待補]`;
    cap.textContent = `${g.cap} · ${g.kind === 'video' ? '影片' : '照片'}`;
  };
  tiles.forEach((t) => t.addEventListener('click', () => { show(Number(t.dataset.i)); lb.showModal(); }));
  lb.querySelector('.lb-prev').addEventListener('click', () => show(cur - 1));
  lb.querySelector('.lb-next').addEventListener('click', () => show(cur + 1));
  lb.querySelector('.lb-close').addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
</script>

<style>
  .sec-head { display: flex; align-items: baseline; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
  .sec-head h2 { margin: 0; font-size: 24px; font-weight: 700; }
  .sec-head span { font-size: 15px; color: var(--muted); }
  .people { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(190px, 45%), 1fr)); gap: 28px 20px; }
  .person { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  /* 年級分區 */
  .grade { display: flex; flex-direction: column; gap: 20px; padding-top: 8px; }
  .grade-head { display: flex; align-items: center; gap: 14px; }
  .grade-head b { font-size: 20px; }
  .grade-head .stack > span { font-size: 13px; color: var(--muted); }
  .grade-code { min-width: 48px; height: 48px; padding: 0 10px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-family: var(--display); font-size: 24px; font-weight: 700; letter-spacing: .04em; color: #fff; background: var(--accent); box-shadow: 0 6px 14px rgba(30,28,24,.14); }
  .grade:has(.tier-M1) .grade-code { background: var(--wood); }
  .grade-pi .grade-code { color: #3A2C12; background: linear-gradient(135deg, #F3DE9C, #C79A3E 55%, #9C7428); }
  /* 頭像相框：大小一律相同，只換框與小特效；滑鼠移上去 3D 傾斜 */
  .frame { --rx: 0deg; --ry: 0deg; --mx: 50%; --my: 30%; position: relative; width: 168px; height: 168px; max-width: 100%; transform-style: preserve-3d; transform: perspective(700px) rotateX(var(--rx)) rotateY(var(--ry)); transition: transform .45s cubic-bezier(.2,.8,.2,1); }
  .frame.tilting { transition: transform .08s linear; }
  .person:hover .frame, .person.open .frame { translate: 0 -6px; }
  .ring { position: absolute; inset: -7px; border-radius: 50%; background: var(--line-2); transform: translateZ(-1px); box-shadow: 0 12px 26px rgba(30,28,24,.14); }
  .tier-M1 .ring { background: conic-gradient(from 210deg, #C08B5C, #EBD3B3, #C08B5C 50%, #8E6440, #C08B5C); }
