---
// 拉拉看照片收集頁（手機用）：對位 → 存成 <成員檔名>.jpg → 到 GitHub 上傳到 public/lala/。
// 收集完把 src/data/lala-upload.json 的 open 改成 false 就關閉。
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { NAV } from '../config/nav';
import { getMembers, lalaUploaded, u } from '../lib';
import cfg from '../data/lala-upload.json';

const { pi, current } = await getMembers();
const people = [...pi, ...current].map((m) => ({ id: m.id, name: m.data.name, done: lalaUploaded(m.id) }));
const uploadUrl = `https://github.com/${cfg.repo}/upload/${cfg.branch}/public/lala`;
---
<Layout title="上傳拉拉看照片" active={NAV.members}>
  <Hero eyebrow="Lala Avatar" title="上傳拉拉看照片" lead="用手機拍一張正面照，對準紅點，傳上 GitHub，成員頁的頭像就會變成可以拉長、會眨眼的拉拉看。" />

  <section class="wrap lala-up">
    {!cfg.open ? (
      <p class="closed">照片收集已結束，謝謝大家。需要更新照片請找網站管理員。</p>
    ) : (
      <div id="lala-up" data-upload={uploadUrl}>
        <ol class="steps">
          <li>
            <h2>1. 選自己的名字</h2>
            <select id="who" required>
              <option value="">— 選擇 —</option>
              {people.map((p) => <option value={p.id}>{p.name}{p.done ? '（已上傳過，再傳會覆蓋）' : ''}</option>)}
            </select>
            <p class="hint">名單上沒有你？先請 AI 幫你在 <code>src/content/members/</code> 新增自己的資料。</p>
          </li>
          <li>
            <h2>2. 拍照或選照片</h2>
            <p class="hint">正面、頭不要歪、雙眼睜開、嘴巴閉著不要笑，光線均勻。</p>
            <label class="btn btn-ghost pick">拍照／選照片<input id="file" type="file" accept="image/*" capture="user" hidden /></label>
          </li>
          <li id="step-align" hidden>
            <h2>3. 對準紅點</h2>
            <p class="hint">一指拖曳移動，兩指縮放、旋轉，讓<b>兩眼</b>和<b>兩個嘴角</b>剛好落在紅點上。電腦可用滑鼠拖曳、滾輪縮放。</p>
            <canvas id="stage" width="640" height="640"></canvas>
            <div class="row">
              <button type="button" class="btn btn-ghost" data-rot="-1">↺ 轉 1°</button>
              <button type="button" class="btn btn-ghost" data-rot="1">↻ 轉 1°</button>
              <button type="button" class="btn btn-ghost" id="reset">重來</button>
            </div>
          </li>
          <li id="step-save" hidden>
            <h2>4. 存檔並上傳</h2>
            <button type="button" class="btn btn-coral" id="save">存下照片</button>
            <div id="after" hidden>
              <p>已存成 <b id="fname"></b>。接著：</p>
              <ol class="sub">
                <li>按下面的按鈕開啟 GitHub（用收到協作邀請的帳號登入）。</li>
                <li>選 <b>choose your files</b>，挑剛存的 <b id="fname2"></b>（檔名不要改）。</li>
                <li>拉到最下面，選 <b>Commit directly to the main branch</b>，按 <b>Commit changes</b>。</li>
              </ol>
              <a class="btn btn-coral" id="gh" href={uploadUrl} target="_blank" rel="noopener">到 GitHub 上傳 →</a>
              <p class="hint">約 2～5 分鐘後到 <a href={u('/members/')}>成員頁</a> 看結果。手機上 GitHub 沒有上傳按鈕時，瀏覽器選單切換成「電腦版網站」。</p>
            </div>
          </li>
        </ol>
      </div>
    )}
  </section>
</Layout>

<script>
  import { T, EYES, MOUTH } from '../scripts/lala';

  const root = document.getElementById('lala-up');
  if (root) {
    const $ = <E extends HTMLElement>(id: string) => document.getElementById(id) as E;
    const who = $<HTMLSelectElement>('who');
    const file = $<HTMLInputElement>('file');
    const stage = $<HTMLCanvasElement>('stage');
    const ctx = stage.getContext('2d')!;
    let img: HTMLImageElement | null = null;
    // 照片在畫布上的位置：中心 (x, y)、縮放 s、旋轉 r（弧度）
    let x = T / 2, y = T / 2, s = 1, r = 0;

    const fit = () => { if (!img) return; s = T / Math.min(img.naturalWidth, img.naturalHeight); x = y = T / 2; r = 0; };
    const drawPhoto = (c: CanvasRenderingContext2D) => {
      c.save();
      c.fillStyle = '#fff'; c.fillRect(0, 0, T, T);
      c.translate(x, y); c.rotate(r); c.scale(s, s);
      c.drawImage(img!, -img!.naturalWidth / 2, -img!.naturalHeight / 2);
      c.restore();
    };
    const draw = () => {
      if (!img) return;
      drawPhoto(ctx);
      ctx.save();
      ctx.strokeStyle = 'rgba(255,255,255,.7)'; ctx.lineWidth = 2; ctx.setLineDash([8, 8]);
      ctx.beginPath(); ctx.moveTo(0, EYES[0][1]); ctx.lineTo(T, EYES[0][1]);
      ctx.moveTo(0, MOUTH[0][1]); ctx.lineTo(T, MOUTH[0][1]); ctx.moveTo(T / 2, 0); ctx.lineTo(T / 2, T); ctx.stroke();
      ctx.setLineDash([]);
      for (const [px, py] of [...EYES, ...MOUTH]) {
        ctx.beginPath(); ctx.arc(px, py, 9, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(224,48,48,.9)'; ctx.fill();
        ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.stroke();
      }
      ctx.restore();
    };

    file.addEventListener('change', () => {
      const f = file.files?.[0];
      if (!f) return;
      const im = new Image();
      im.onload = () => {
        img = im; fit(); draw();
        $('step-align').hidden = false; $('step-save').hidden = false; $('after').hidden = true;
        $('step-align').scrollIntoView({ behavior: 'smooth' });
      };
      im.src = URL.createObjectURL(f);
    });

    // 手勢：一指移動；兩指縮放＋旋轉（以兩指中點為軸）
    const pts = new Map<number, { x: number; y: number }>();
    const pos = (e: PointerEvent) => {
      const b = stage.getBoundingClientRect();
      return { x: (e.clientX - b.left) * T / b.width, y: (e.clientY - b.top) * T / b.height };
    };
    const pair = () => {
      const [a, b] = [...pts.values()];
      return { cx: (a.x + b.x) / 2, cy: (a.y + b.y) / 2, d: Math.hypot(b.x - a.x, b.y - a.y), ang: Math.atan2(b.y - a.y, b.x - a.x) };
    };
    // 以 (cx, cy) 為軸縮放 k 倍、旋轉 da
    const around = (cx: number, cy: number, k: number, da: number) => {
      const dx = (x - cx) * k, dy = (y - cy) * k;
      x = cx + dx * Math.cos(da) - dy * Math.sin(da);
      y = cy + dx * Math.sin(da) + dy * Math.cos(da);
      s *= k; r += da;
    };
    stage.addEventListener('pointerdown', (e) => { stage.setPointerCapture(e.pointerId); pts.set(e.pointerId, pos(e)); });
    stage.addEventListener('pointermove', (e) => {
      if (!img || !pts.has(e.pointerId)) return;
      const before = pts.size === 2 ? pair() : null;
      const old = pts.get(e.pointerId)!, now = pos(e);
      pts.set(e.pointerId, now);
      if (before) {
        const after = pair();
        x += after.cx - before.cx; y += after.cy - before.cy;
        around(after.cx, after.cy, after.d / before.d, after.ang - before.ang);
      } else if (pts.size === 1) {
        x += now.x - old.x; y += now.y - old.y;
      }
      draw();
    });
    const up = (e: PointerEvent) => pts.delete(e.pointerId);
    stage.addEventListener('pointerup', up);
    stage.addEventListener('pointercancel', up);
    stage.addEventListener('wheel', (e) => {
      if (!img) return;
      e.preventDefault();
      const p = pos(e as unknown as PointerEvent);
      around(p.x, p.y, Math.exp(-e.deltaY / 500), 0); draw();
    }, { passive: false });
    root.querySelectorAll<HTMLButtonElement>('[data-rot]').forEach((b) => b.addEventListener('click', () => {
      around(T / 2, T / 2, 1, Number(b.dataset.rot) * Math.PI / 180); draw();
    }));
    $('reset').addEventListener('click', () => { fit(); draw(); });

    $('save').addEventListener('click', () => {
      if (!who.value) { alert('先在第 1 步選自己的名字'); who.focus(); return; }
      if (!img) return;
      const out = document.createElement('canvas');
      out.width = out.height = T;
      drawPhoto(out.getContext('2d')!);
      out.toBlob((blob) => {
        if (!blob) return;
        const name = `${who.value}.jpg`;
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob); a.download = name;
        document.body.append(a); a.click(); a.remove();
        $('fname').textContent = name; $('fname2').textContent = name;
        $('after').hidden = false;
        $('after').scrollIntoView({ behavior: 'smooth' });
      }, 'image/jpeg', 0.9);
    });
  }
</script>

<style>
  .lala-up { padding-top: 48px; padding-bottom: 88px; max-width: 640px; }
  .closed { font-size: 17px; color: var(--muted); }
  .steps, .sub { padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: 36px; }
  .sub { gap: 6px; padding-left: 1.2em; list-style: decimal; margin: 8px 0 16px; }
  h2 { font-family: var(--serif); font-size: 20px; margin: 0 0 10px; }
  .hint { color: var(--muted); font-size: 14px; line-height: 1.7; margin: 8px 0; }
  select { width: 100%; font: inherit; font-size: 16px; padding: 10px 12px; border: 1px solid var(--line-2); border-radius: 8px; background: var(--surface); color: var(--ink); }
  .pick { cursor: pointer; }
  canvas { width: 100%; max-width: 480px; aspect-ratio: 1; display: block; border-radius: 12px; border: 1px solid var(--line); touch-action: none; background: var(--surface); }
  .row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
</style>
