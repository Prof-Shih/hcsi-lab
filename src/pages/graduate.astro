---
import { u } from '../lib';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { NAV } from '../config/nav';
import { getSite, getMembers, imagePicker, masterCat, initial } from '../lib';
import details from '../data/project-details.json';

const [site, { current, alumni }] = await Promise.all([getSite(), getMembers()]);
// 頁面上已固定使用的圖先標記，卡片就不會再重複
const pick = imagePicker(new Set(['/images/pose.jpg', '/images/robot.jpg', '/images/glove.jpg']));
const theses = details.theses as Record<string, { slug: string; hook: string }>;
const masters = alumni.filter((x) => x.data.thesis).map(({ id, data: m }) => {
  const c = masterCat(m.thesis);
  const d = theses[id];
  return { ...m, ...c, img: pick(c.imgs), year: m.grad_year, note: m.honor, href: d ? u(`/graduate/${d.slug}/`) : '', hook: d?.hook ?? '' };
});
// 依 115 學年資管所碩士班科目表（共同必修、英文門檻、口試條件）與實驗室慣例整理
const steps: [string, string, string[]][] = [
  ['碩0', '錄取後的暑假', ['聚餐破冰，認識老師和學長姐', '想做什麼大事，隨時找老師和實驗室提', '先摸實驗室設備：耐能 NPU、樹莓派、深度相機']],
  ['碩一上', '修課為主', ['所必修：軟體工程、管理資訊系統，再加組必修', '多益 785 以上可申請免修進修英文', '開始接助教或國科會計畫，有助學金', '參加 group meeting，跟著學長姐的計畫做']],
  ['碩一下', '定題目', ['所必修：研究方法', '和老師定碩論題目，做出第一版系統', '投國內研討會練手（CVGIP、TANET）']],
  ['碩一暑假', '衝刺發表', ['補齊實驗，投國際會議（ICCE、GCCE、IEEE AI-Sports Workshop）', '想實習或參加 AI 競賽，跟老師討論']],
  ['碩二上', '帶人也被帶', ['所必修：管理溝通', '碩論完整實驗', '帶碩一學弟妹與專題生，接助教']],
  ['碩二下', '畢業', ['所必修：書報研討', '修完學術研究倫理、通過英文門檻後申請口試', '碩論延伸投期刊']],
];
---
<Layout title="研究所" active={NAV.graduate}>
  <Hero eyebrow="Graduate Program" title="在這裡讀碩士" lead="做真的硬體、跑真的模型、投國際會議。兩年後帶著作品與論文畢業。" img="/images/pose.jpg" bg="#2F3B36" />

  <section class="wrap section reveal">
    <h2 class="h2">為什麼選這裡</h2>
    <div class="why">
      <div class="card zoom">
        <img src={u('/images/robot.jpg')} alt="Otto DIY 機器人" class="why-img" loading="lazy" />
        <div class="why-body"><b>摸得到邊緣運算</b><span>耐能 Kneron NPU／USB AI 加速棒、Raspberry Pi 4/5、深度攝影機，模型直接部署到裝置上。</span></div>
      </div>
      <div class="card">
        <div class="why-img why-fill" style="background:#4A685D"><span style="font-family:var(--display);font-size:72px;font-weight:600;line-height:1">NSTC</span><span style="font-size:15px">國科會計畫連續執行</span></div>
        <div class="why-body"><b>研究經費充足</b><span>主持 4 年期精準運動科學整合計畫、智慧醫療與網球分析計畫，設備與出國發表有支援。</span></div>
      </div>
      <div class="card">
        <div class="why-img why-fill" style="background:#3E4A5A;align-items:flex-start;padding:24px;gap:10px;font-size:18px"><span>USA · Santa Clara University</span><span>Japan · Hokkaido University</span><span>IEEE ICME AI-Sports Workshop</span></div>
        <div class="why-body"><b>國際合作</b><span>與美、日教授共同指導、共同發表；老師 2020–2024 在 IEEE ICME 舉辦 AI-Sports 工作坊。</span></div>
      </div>
      <div class="card zoom">
        <img src={u('/images/glove.jpg')} alt="壓力感測打擊手套" class="why-img" loading="lazy" />
        <div class="why-body"><b>論文會發表</b><span>學長姐碩論延伸成 IEEE ESL、ICMEW、Sensors 論文，並拿過民生電子學會碩論獎佳作。</span></div>
      </div>
    </div>
  </section>

  <section class="band reveal">
    <div class="wrap section">
      <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:12px">
        <h2 class="h2">碩士兩年怎麼過</h2>
        <span class="star" style="font-weight:400;font-size:13px">依 115 學年資管所課程規定整理，實際以系所公告為準</span>
      </div>
      <ol class="timeline">
        {steps.map(([k, t, items]) => <li><span class="tl-k">{k}</span><b class="tl-t">{t}</b><ul class="tl-v">{items.map((x) => <li>{x}</li>)}</ul></li>)}
      </ol>
    </div>
  </section>

  <section class="wrap section reveal" id="theses">
    <div class="row-between">
      <h2 class="h2">學長姐做了什麼 <small>{masters.length} 篇碩士論文</small></h2>
      <span class="note" style="font-size:14px">元智電機時期 · 畢業去向待補</span>
    </div>
    <div class="grid-auto">
      {masters.map((m) => {
        const Card = m.href ? 'a' : 'div';
        return (
        <Card class="card zoom thesis" href={m.href || undefined}>
          <div style={`position:relative;aspect-ratio:16/9;background:${m.bg}`}>
            {m.img && <img src={u(m.img)} alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />}
            <span class="tag" style="left:12px">{m.tag}</span>
          </div>
          <div class="card-body" style="gap:8px">
            <b style="font-size:16px;line-height:1.5">{m.thesis}</b>
            <span style="font-size:14px;color:var(--muted)">{m.name} · {m.year} 畢業</span>
            {m.note && <span class="star">★ {m.note}</span>}
            {m.job && <span style="font-size:13px;color:var(--accent-ink)">→ {m.job}</span>}
            {m.hook && <span class="hook">{m.hook}</span>}
            {m.href && <span class="more">看詳細 →</span>}
          </div>
        </Card>
        );
      })}
    </div>
  </section>

  <section class="reveal" style="background:var(--surface);border-top:1px solid var(--line)">
    <div class="wrap section" style="flex-direction:row;flex-wrap:wrap;gap:48px">
      <div style="flex:1 1 420px;min-width:0;display:flex;flex-direction:column;gap:20px">
        <div class="row-between">
          <h2 class="h2">現在的夥伴</h2>
          <a href={u('/members/')} style="font-size:15px">認識他們 →</a>
        </div>
        <div class="team">
          {current.map(({ data: p }) => (
            <a href={u('/members/#people')}><span class="avatar">{initial(p.name)}</span><b>{p.name}</b></a>
          ))}
        </div>
      </div>
      <div class="join">
        <div style="font-family:var(--serif);font-size:28px;font-weight:700">怎麼加入</div>
        <ol>
          <li>寄信給老師，附上履歷與有興趣的研究主題</li>
          <li>約時間來實驗室看看、跟學長姐聊</li>
          <li>推甄／考試錄取後確認指導</li>
        </ol>
        <span style="font-size:13px;color:#B9C4BF">[招生條件 — 待老師確認]</span>
        <a class="btn btn-coral" style="align-self:flex-start" href={`mailto:${site.email}`}>寄信 {site.email}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  a.thesis { color: inherit; text-decoration: none; }
  .thesis .hook { font-size: 14px; line-height: 1.6; color: var(--accent-ink); }
  .thesis .more { margin-top: auto; font-size: 13px; font-weight: 600; color: var(--accent-ink); }
  .why { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr)); gap: 20px; }
  .why-img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .why-fill { color: #fff; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 4px; }
  .why-body { padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .why-body b { font-size: 20px; }
  .why-body span { font-size: 15px; line-height: 1.65; color: #4A4A4A; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 16px; counter-reset: tl; }
  .timeline > li { position: relative; padding: 22px 20px 20px; background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 6px; display: flex; flex-direction: column; gap: 6px; transition: transform .3s, box-shadow .3s; }
  .timeline > li:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(30,28,24,.1); }
  .timeline > li:nth-child(4) { border-top-color: var(--wood); }
  .timeline > li:last-child { border-top-color: var(--coral); }
  .tl-k { font-family: var(--display); font-size: 34px; font-weight: 600; line-height: 1; color: var(--accent-ink); }
  .tl-t { font-size: 16px; }
  .tl-v { margin: 4px 0 0; padding-left: 1.1em; font-size: 14px; line-height: 1.7; color: #4A4A4A; }
  .team { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .team a { display: flex; flex-direction: column; align-items: center; gap: 8px; text-decoration: none; color: var(--ink); }
  .avatar { width: 96px; height: 96px; border-radius: 50%; background: #DCE5E0; color: #3D5A50; display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-size: 34px; }
  .join { flex: 1 1 360px; min-width: 0; background: var(--pine); color: #F2EFE8; border-radius: 6px; padding: 36px; display: flex; flex-direction: column; gap: 16px; }
  .join ol { margin: 0; padding: 0; list-style: none; counter-reset: s; display: flex; flex-direction: column; gap: 12px; font-size: 16px; line-height: 1.6; }
  .join li { counter-increment: s; display: flex; gap: 12px; }
  .join li::before { content: counter(s); flex: 0 0 28px; height: 28px; border-radius: 50%; background: var(--wood); color: #1E1F1D; display: flex; align-items: center; justify-content: center; font-weight: 700; }
  @media (max-width: 767px) { .avatar { width: 72px; height: 72px; font-size: 26px; } .join { padding: 24px; } }
</style>
