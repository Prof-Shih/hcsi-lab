---
import { u } from '../../lib';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { RESEARCH_GROUPS } from '../../content.config';
import { NAV } from '../../config/nav';
import { getTopics, getMembers, getPubs, related } from '../../lib';

const [topics, { alumni }, pubs] = await Promise.all([getTopics(), getMembers(), getPubs()]);
const groups = RESEARCH_GROUPS.map((g, gi) => ({
  no: String(gi + 1).padStart(2, '0'),
  ...g,
  topics: topics.filter((t) => t.data.group === g.zh).map((t) => {
    const r = related(t, alumni, pubs);
    return { id: t.id, ...t.data, countLine: `${r.masters.length} 篇碩論 · ${r.projects.length} 組專題 · ${r.pubs.length} 篇論文` };
  }),
}));
---
<Layout title="研究主題" active={NAV.research}>
  <Hero eyebrow="Research Topics" title="研究主題" lead="點一張卡片，看這個主題的成果照片、學長姐做過的論文與專題。" />
  <section class="wrap" style="padding-top:56px;padding-bottom:96px;display:flex;flex-direction:column;gap:40px">
    {groups.filter((g) => g.topics.length > 0).map((g) => (
      <div class="reveal" style="display:flex;flex-direction:column;gap:16px">
        <div class="group-head">
          <span class="no">{g.no}</span><span class="zh">{g.zh}</span><span class="en">{g.en}</span>
        </div>
        <div class="topic-cards">
          {g.topics.map((t) => (
            <a class="tcard zoom" href={u(`/research/${t.id}/`)} style={`background:${t.color}`}>
              {t.cover && <img src={u(t.cover)} alt="" loading="lazy" />}
              <div class="tcard-body">
                <div class="t-zh">{t.title}</div>
                <div class="t-line">{t.tagline}</div>
                <div class="t-count">{t.countLine} · 看詳細 →</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>

<style>
  .group-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
  .no { font-family: var(--display); font-size: 28px; font-weight: 600; color: var(--accent-ink); }
  .zh { font-size: 20px; font-weight: 700; }
  .en { font-family: var(--latin); font-size: 14px; color: var(--muted); }
  .topic-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 20px; }
  .tcard { position: relative; display: block; aspect-ratio: 16 / 9; border-radius: 6px; color: #fff; text-decoration: none; }
  .tcard:hover { color: #fff; }
  .tcard img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .6; }
  .tcard-body { position: absolute; inset: 0; padding: 28px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; }
  .t-zh { font-size: 28px; font-weight: 700; }
  .t-line { font-size: 15px; color: #EDE9E1; }
  .t-count { font-size: 13px; color: #EDE9E1; padding-top: 6px; }
  @media (max-width: 767px) { .tcard-body { padding: 20px; } .t-zh { font-size: 22px; } }
</style>
